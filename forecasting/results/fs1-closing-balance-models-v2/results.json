  "models": {
    "drift_calendar": "Decomposes daily net cash movements into sample drift plus shrunk day-of-week and day-of-month recurring calendar effects fitted strictly on history <= origin, rolled forward cumulatively.",
    "ensemble_ml": "Inverse-squared-MAE adaptive ensemble combining drift_calendar, gbdt_direct, and invoice_aware_ml (or drift_calendar and gbdt_direct when open invoices are omitted) using strictly past rolling out-of-sample residuals with split-conformal intervals.",
    "gbdt_direct": "Direct multi-horizon gradient-boosted regression trees predicting cumulative net cash movement y(t+h)-y(t) from strictly causal lags, multi-day changes, rolling statistics, EWMA trends, and target-window calendar features fitted on history <= origin.",
    "invoice_aware_ml": "Hybrid StandardScaler + Ridge(alpha=50.0) and GBDT residual model combining causal cash-flow features with point-in-time open invoice schedules and shrunk empirical settlement lag/rate statistics reconstructed strictly from issue_date <= origin and booked_date <= origin.",
    "naive": "Persistence benchmark: y_hat(t+h|t) = y(t).",
    "ridge_lag_calendar": "L2-regularized Ridge regression (alpha=100.0) on daily net movement using lag, rolling-mean, day-of-week, day-of-month, and quarter-end-month features standardized strictly on history <= origin, rolled forward recursively."
  },
