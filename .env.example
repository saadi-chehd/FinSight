# Template only: provisioning creates root .env; never overwrite or commit .env.
# Export for Spring and Python commands using: set -a; source .env; set +a
BACKEND_PORT=8080
BACKEND_HOST=127.0.0.1
FORECAST_PORT=8000
# Vite reads these from the root via envDir; they are public, never secrets.
VITE_PORT=5173
VITE_BACKEND_TARGET=http://127.0.0.1:8080
# Local PostgreSQL credentials; set real passwords only in ignored .env.
DB_URL=jdbc:postgresql://127.0.0.1:5432/finsight
DB_USER=finsight_app
DB_PASSWORD=replace_with_local_password
# Integration tests accept only this separate local database and role.
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/finsight_test
TEST_DB_USER=finsight_test_app
TEST_DB_PASSWORD=replace_with_different_local_password

# Same currency units as each SME; zero warns only on negative closing balances.
LIQUIDITY_WARNING_THRESHOLD=0.00
# Technical bound on inclusive report length, not a financial forecast horizon.
FINANCIAL_MAX_REPORT_DAYS=3660
